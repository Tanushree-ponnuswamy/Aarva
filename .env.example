# ==============================================================================
#  AARVA AI Platform - Docker Deployment Environment Variables (.env.example)
#  Copy this file to `.env` in the root folder for Docker Compose:
#    cp .env.example .env
# ==============================================================================

# ── Port Bindings ─────────────────────────────────────────────────────────────
FRONTEND_PORT=80
FRONTEND_ALT_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5432

# ── Application Environment ───────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
CORS_ORIGINS=http://localhost,http://localhost:5173   # explicit origins only; "*" is ignored

# ── Database Credentials ──────────────────────────────────────────────────────
POSTGRES_DB=aarva_db
POSTGRES_USER=aarva_user
POSTGRES_PASSWORD=aarva_super_secure_password_2026

# ── Security & JWT Secret ─────────────────────────────────────────────────────
# Generate a secure 64-char hex key: openssl rand -hex 32
JWT_SECRET=                      # REQUIRED. Generate: openssl rand -hex 32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── LLM & AI Engine (Ollama) ──────────────────────────────────────────────────
# Default connects to Ollama running on your host machine:
OLLAMA_BASE_URL=http://host.docker.internal:11434
# If running with the docker profile `--profile with-ollama`:
# OLLAMA_BASE_URL=http://ollama:11434

LLM_MODEL=qwen3:8b
EMBEDDING_MODEL=bge-large:latest
EMBEDDING_DIMENSION=1024

# ── Frontend API Configuration ────────────────────────────────────────────────
# Leave empty so Nginx reverse-proxies /api requests internally.
# Set only if frontend is hosted on a separate CDN/subdomain.
VITE_API_URL=

# ── SMTP Mail Service (For Registration OTPs) ─────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=                    # Gmail: use an App Password; never commit it
SMTP_FROM_EMAIL=

# ── Accounts ──────────────────────────────────────────────────────────────────
ENABLE_DEMO_LOGIN=true            # shared "Try demo" student account (short-lived tokens)
ADMIN_EMAIL=admin@aarva.edu
ADMIN_PASSWORD=                   # >=12 chars. Admin is only created when this is set
